# Copy to .env.local. Every key is optional: without it the feature falls back to fixtures,
# recorded runs (data/replay) or deterministic templates instead of failing.
# Never commit real values.

# --- Mode -------------------------------------------------------------------
DEMO_MODE=false                # true = serve fixtures and the committed cache only (no API keys needed)
KEYSTONE_DEFAULT_MODE=         # demo | live; empty = demo on Vercel, else live when OPENAI_API_KEY is set
KEYSTONE_REPLAY_STRICT=        # true = Demo never falls through to live OpenAI/Firecrawl/ElevenLabs on a replay miss
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- LLM (OpenAI-compatible) --------------------------------------------------
OPENAI_API_KEY=
LLM_MODEL=                     # chat model id your key supports
EMBEDDING_MODEL=               # default: text-embedding-3-small

# --- Data sources -------------------------------------------------------------
FIRECRAWL_API_KEY=             # live syllabus scraping and Guides search
ADZUNA_APP_ID=                 # live job ads (Adzuna first, Reed as fallback)
ADZUNA_APP_KEY=
REED_API_KEY=
TRENDS_LIVE=                   # true = live Hacker News "Who is hiring" backfill (slow)

# --- GitHub (pods, Project Architect, AI Tech Lead) ---------------------------
GITHUB_TOKEN=                  # fine-grained PAT: read public data + create repos/issues in GITHUB_ORG
GITHUB_ORG=
GITHUB_WEBHOOK_SECRET=         # must match the secret on the repo/org webhook -> /api/webhooks/github

# --- Voice (ElevenLabs) ---------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_INTERVIEW_AGENT_ID=
ELEVENLABS_VOICE_ID=

# --- Automations and machine-to-machine calls ---------------------------------
N8N_WEBHOOK_BASE_URL=
KEYSTONE_SHARED_SECRET=        # n8n, ElevenLabs tool webhooks and the MCP endpoint send this (long random string)

# --- Split deployment -----------------------------------------------------------
BACKEND_URL=                   # e.g. the Render service URL: this deployment then proxies /api/* to it
