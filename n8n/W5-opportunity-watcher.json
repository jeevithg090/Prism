        "width": 460
      },
      "id": "12789b03-bece-569b-8891-61f4aa74c997",
      "name": "Setup notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -340
      ]
    },
    {
