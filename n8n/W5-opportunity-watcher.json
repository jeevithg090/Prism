      "webhookId": "8d8a1b23-5f50-5509-97a5-5777fb61060e"
    },
    {
      "parameters": {
        "jsCode": "// Edit these once after importing (no secrets here: secrets live in n8n credentials).\nreturn [{ json: {\n  appUrl: 'https://REPLACE-WITH-YOUR-KEYSTONE-URL',   // e.g. https://keystone.vercel.app (no trailing slash)\n  userIds: ['aisha'],\n  roles: ['ml-engineer', 'software-engineer', 'data-analyst'],\n  voiceId: 'JBFqnCBsd6RMkjVDRZzb',                      // ELEVENLABS_VOICE_ID\n} }];"
      },
      "id": "ba17493f-bff6-5112-8d7e-861f1cb9542c",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        100
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.appUrl }}/api/market/ml-engineer",
        "options": {}
      },
      "id": "530f6aef-37c2-5a57-b6be-5911062957a6",
      "name": "GET ML engineer market",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $json.data ?? {};\nconst ads = (d.sampleAds ?? []).filter((a) => /intern|graduate|junior|placement/i.test(a.title)).slice(0, 3);\nif (!ads.length) return [];\nconst top = (d.skills ?? []).slice(0, 3).map((s) => `${s.skillId} ${Math.round(s.share * 100)}%`).join(' · ');\nreturn [{ json: { content: `🔎 New early-career ML engineer openings (${d.adsAnalysed ?? '?'} ads analysed; top skills: ${top})\\n` + ads.map((a) => `• ${a.title} at ${a.company}: ${a.url}`).join('\\n') } }];"
      },
      "id": "083b607d-a825-5cd5-a08d-ff787cd5d3e9",
      "name": "Pick early-career ads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        100
      ]
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "={{ $json.content }}",
