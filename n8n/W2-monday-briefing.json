{
  "name": "Keystone W2 · Monday voice briefing → Discord",
  "nodes": [
    {
      "parameters": {
        "content": "## W2 · Monday briefing\nEvery Monday 08:00 (Europe/London) — or click **Execute workflow** on the Manual Trigger for the live demo.\n\nGET `{APP_URL}/api/briefing/{BRIEFING_USER_ID}` → ElevenLabs TTS (MP3) → Discord #briefings webhook with the MP3 attached and the top 3 tasks.\n\nCredentials: **Keystone shared secret** (Header Auth `x-keystone-secret`) and **ElevenLabs API key** (Header Auth `ElevenLabs API-key header`).",
        "height": 300,
        "width": 520
      },
      "id": "9223af21-5044-4275-89d0-3163ad058a30",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -260,
        -380
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1"
            }
          ]
        }
      },
      "id": "554f51a1-6bfd-4f26-9e56-ec9f0a97c963",
      "name": "Every Monday 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        -100
      ]
    },
    {
      "parameters": {},
      "id": "a85d834c-44fb-4289-90dd-cb298a5b1c40",
      "name": "Run now (demo)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        100
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "f3e58823-0000",
              "name": "APP_URL",
              "value": "https://YOUR-APP-URL",
              "type": "string"
            },
            {
              "id": "f3e58823-0001",
              "name": "BRIEFING_USER_ID",
              "value": "aisha",
              "type": "string"
            },
            {
              "id": "f3e58823-0002",
              "name": "DISCORD_WEBHOOK_URL",
              "value": "https://discord.com/api/webhooks/YOUR_BRIEFINGS_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN",
              "type": "string"
            },
            {
              "id": "f3e58823-0003",
              "name": "ELEVENLABS_VOICE_ID",
              "value": "YOUR_ELEVENLABS_VOICE_ID",
              "type": "string"
            },
            {
              "id": "f3e58823-0004",
              "name": "ELEVENLABS_MODEL_ID",
              "value": "eleven_multilingual_v2",
              "type": "string"
            },
            {
              "id": "f3e58823-0005",
              "name": "ELEVENLABS_API_BASE",
              "value": "https://api.elevenlabs.io",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "f3e58823-646b-4786-9b3c-1ad3ae4b8c4f",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ],
      "notes": "Edit me: app URL, #briefings webhook, ElevenLabs voice id",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.APP_URL.replace(/\\/+$/, '') }}/api/briefing/{{ $json.BRIEFING_USER_ID }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "id": "94eade18-5ee9-4193-adc5-c6dc60319d42",
      "name": "Get briefing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ksSharedSecret01",
          "name": "Keystone shared secret"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Unwraps the ApiResult envelope from GET /api/briefing/:userId\nconst res = $input.first().json || {};\nif (res.ok !== true || !res.data) {\n  throw new Error(`Briefing API did not return ok:true — got: ${JSON.stringify(res).slice(0, 300)}`);\n}\nconst b = res.data;\nconst script = String(b.script || '').trim();\nif (!script) throw new Error('Briefing has an empty script');\nconst tasks = (Array.isArray(b.topTasks) ? b.topTasks : []).slice(0, 3).map(String);\nconst content = ['🎧 Your Keystone briefing for this week', ...tasks.map((t) => `• ${t}`)]\n  .join('\\n')\n  .slice(0, 1900);\nconst weekOf = String(b.weekOf || new Date().toISOString().slice(0, 10)).replace(/[^0-9A-Za-z-]/g, '');\nreturn [{ json: {\n  script: script.slice(0, 4900),\n  topTasks: tasks,\n  weekOf,\n  fileName: `keystone-briefing-${b.userId || 'user'}-${weekOf}.mp3`,\n  discordPayload: { content },\n} }];\n"
      },
      "id": "7dc21b6b-942f-4d3c-b3e3-72e77e9d51e4",
      "name": "Extract script",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.ELEVENLABS_API_BASE.replace(/\\/+$/, '') }}/v1/text-to-speech/{{ $('Config').first().json.ELEVENLABS_VOICE_ID }}?output_format=mp3_44100_128",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "audio/mpeg"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.script, model_id: $('Config').first().json.ELEVENLABS_MODEL_ID }) }}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "6590ec15-10d2-48e9-a1ea-ed970cd0bf29",
      "name": "ElevenLabs TTS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ksElevenLabsKey1",
          "name": "ElevenLabs API key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Give the MP3 a proper name + mime type so Discord renders an audio player.\nconst meta = $('Extract script').first().json;\nconst items = $input.all();\nfor (const item of items) {\n  if (!item.binary || !item.binary.data) throw new Error('ElevenLabs returned no audio (binary \"data\" missing)');\n  item.binary.data.fileName = meta.fileName;\n  item.binary.data.fileExtension = 'mp3';\n  item.binary.data.mimeType = 'audio/mpeg';\n}\nreturn items;\n"
      },
      "id": "50de4df2-e168-4e75-adce-d96bbb6425cf",
      "name": "Name the MP3",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ (() => { const u = $('Config').first().json.DISCORD_WEBHOOK_URL; return u + (u.includes('?') ? '&' : '?') + 'wait=true'; })() }}",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "files[0]",
              "inputDataFieldName": "data"
            },
            {
              "parameterType": "formData",
              "name": "payload_json",
              "value": "={{ JSON.stringify($('Extract script').first().json.discordPayload) }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "a9992073-887f-4254-81ae-1e4f0832cbac",
      "name": "Post MP3 to #briefings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        0
      ]
    }
  ],
