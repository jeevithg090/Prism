              "id": "8bf91ca3-cond",
              "leftValue": "={{ $json.useBot }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "8bf91ca3-af2b-45fd-aece-33c993641cdf",
      "name": "Bot token configured?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.DISCORD_API_BASE.replace(/\\/+$/, '') }}/guilds/{{ $('Config').first().json.DISCORD_GUILD_ID }}/channels",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bot {{ $('Config').first().json.DISCORD_BOT_TOKEN }}"
            },
            {
              "name": "User-Agent",
              "value": "DiscordBot (https://github.com/jeevithg090/Reply_Hack, 1.0)"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.channelCreateBody) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "a1621cea-3045-42e9-a279-83a96f9dc7f5",
      "name": "Create pod channel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        -160
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.DISCORD_API_BASE.replace(/\\/+$/, '') }}/channels/{{ $json.id }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bot {{ $('Config').first().json.DISCORD_BOT_TOKEN }}"
            },
            {
              "name": "User-Agent",
              "value": "DiscordBot (https://github.com/jeevithg090/Reply_Hack, 1.0)"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Build Discord message').first().json.message) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "2c16f175-f3b6-4d47-be92-45ea8fc3a8c4",
      "name": "Post in pod channel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        -160
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Bot branch: link straight to the new pod channel (fall back to #pods on error).\nconst built = $('Build Discord message').first().json;\nconst cfg = $('Config').first().json;\nconst channel = $('Create pod channel').first().json || {};\nconst posted = $input.first().json || {};\nconst ok = !!channel.id && !channel.error && !posted.error;\nreturn [{ json: {\n  discordChannelUrl: channel.id\n    ? `https://discord.com/channels/${cfg.DISCORD_GUILD_ID}/${channel.id}`\n    : built.podsChannelUrl,\n  posted: ok,\n  mode: 'bot',\n} }];\n"
      },
      "id": "9a63de11-2ab8-4f18-bd82-9d87825fdc0b",
      "name": "Channel URL (bot)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        -160
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ (() => { const u = $('Config').first().json.DISCORD_WEBHOOK_URL; return u + (u.includes('?') ? '&' : '?') + 'wait=true'; })() }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.message) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "236a6127-068f-464b-b4a7-741b54294da5",
      "name": "Post to #pods webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        160
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Fallback branch: the message went to the #pods webhook, so link to #pods.\nconst built = $('Build Discord message').first().json;\nconst res = $input.first().json || {};\nreturn [{ json: {\n  discordChannelUrl: built.podsChannelUrl,\n  posted: !res.error,\n  mode: 'webhook',\n} }];\n"
      },
      "id": "2d3c905e-0b32-4b0a-9c15-e9eb549bb25b",
      "name": "Channel URL (webhook)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        160
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ discordChannelUrl: $json.discordChannelUrl, posted: $json.posted, mode: $json.mode }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "a8c6eac3-c0f9-4bd1-9ef5-e760fd3af9fa",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1580,
        0
      ]
    }
