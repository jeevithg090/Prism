{
  "name": "Keystone W6 · newcomer-welcome",
  "nodes": [
    {
      "parameters": {
        "content": "## W6 · newcomer-welcome\nKeystone calls POST /webhook/newcomer-welcome when a 🌱 new-to-uni student finishes onboarding (payload: userId, name). It finds a near-peer buddy (the most similar open-to-chat trajectory) and posts one welcome in #newcomers inviting helpers to say hello in the app. It never messages the student directly.\n\n**Credentials:** Header Auth `x-keystone-secret` on the webhook, Discord webhook for #newcomers. Edit **Config** (app URL).",
        "height": 330,
        "width": 460
      },
      "id": "fbce941a-1735-5dfb-9036-632907b02ef4",
      "name": "Setup notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -360
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "newcomer-welcome",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "e2966591-e122-54cb-acc1-2064939add7c",
      "name": "Webhook: newcomer-welcome",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME_keystone_secret",
          "name": "Keystone shared secret (x-keystone-secret)"
        }
      },
      "webhookId": "07e06d9f-3366-5264-ae70-59279a9e140b"
    },
    {
      "parameters": {
        "jsCode": "// Edit these once after importing (no secrets here: secrets live in n8n credentials).\nreturn [{ json: {\n  appUrl: 'https://REPLACE-WITH-YOUR-KEYSTONE-URL',   // e.g. https://keystone.vercel.app (no trailing slash)\n  userIds: ['aisha'],\n  roles: ['ml-engineer', 'software-engineer', 'data-analyst'],\n  voiceId: 'JBFqnCBsd6RMkjVDRZzb',                      // ELEVENLABS_VOICE_ID\n} }];"
      },
      "id": "1ed28288-5aa5-54e8-88db-b58462842534",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        100
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.appUrl }}/api/trajectories/similar?userId={{ $('Webhook: newcomer-welcome').first().json.body.userId }}&limit=3",
        "options": {}
      },
      "id": "65e7d9f7-179f-59c9-96d9-a11ad8ae0c77",
      "name": "GET similar trajectories",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const b = $('Webhook: newcomer-welcome').first().json.body ?? {};\nconst buddy = ($json.data ?? []).find((x) => x.trajectory?.openToChat)?.trajectory;\nconst first = String(b.name ?? 'a new student').split(' ')[0];\nreturn [{ json: {\n  content: `🌱 Please welcome ${first}, who has just joined Keystone.` + (buddy ? ` ${buddy.name} took a similar path and is open to a 15-minute chat.` : '') + ` Helpers: answer in the Community feed, and you'll earn 🤝 Helper points.`,\n  buddy: buddy?.name ?? null,\n} }];"
      },
      "id": "d0284f20-f8c5-5076-bbf4-1519185aa18f",
      "name": "Build welcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        100
      ]
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "={{ $json.content }}",
        "options": {}
      },
      "id": "565661d0-8a63-571b-b567-1961fdec46a0",
      "name": "Welcome in #newcomers",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        880,
        100
      ],
      "credentials": {
        "discordWebhookApi": {
          "id": "REPLACE_ME_discord_webhook",
          "name": "Discord webhook (#pods / #briefings)"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ welcomed: true, buddy: $('Build welcome').first().json.buddy }) }}",
        "options": {}
      },
      "id": "83259699-c339-5463-a87d-ba67e8a9816d",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1100,
        100
      ]
    }
  ],
