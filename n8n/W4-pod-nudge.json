        "options": {}
      },
      "id": "7aa0d200-8fb5-5309-926a-1f035f6b0a2e",
      "name": "GET my pods",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "return ($json.data ?? []).map((pod) => ({ json: { pod } }));"
      },
      "id": "229e63af-21dd-5014-be1d-9e957fc55c81",
      "name": "One item per pod",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        100
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.appUrl }}/api/projects/progress?podId={{ $json.pod.id }}",
        "options": {}
      },
      "id": "e1f440d6-6942-597d-ae04-2eaf4db1e79c",
      "name": "GET pod progress",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nconst pods = $('One item per pod').all().map((i) => i.json.pod);\n$input.all().forEach((item, idx) => {\n  const pod = pods[idx]; const merged = item.json.data?.merged ?? [];\n  const last = merged.map((m) => Date.parse(m.mergedAt)).sort((a, b) => b - a)[0] ?? Date.parse(pod.createdAt);\n  const days = (Date.now() - last) / 86400000;\n  const done = new Set(merged.map((m) => m.issueIndex));\n  const next = (pod.project?.issues ?? []).find((_, i) => !done.has(i));\n  if (days >= 3 && next) out.push({ json: { content: `👋 ${pod.name}: it's been ${Math.floor(days)} days since the last merge. Next up: \"${next.title}\". ${next.reviewerUserId} is ready to review. Small PRs count.` } });\n});\nreturn out;"
      },
