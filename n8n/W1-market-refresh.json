{
  "name": "Keystone W1 · Weekly market refresh",
  "nodes": [
    {
      "parameters": {
        "content": "## W1 · Market refresh\nSundays 22:00 (Europe/London). For each role in `ROLES`: GET `{APP_URL}/api/market/{role}?refresh=1`, compare skill shares with last run (workflow static data), and if any skill moved more than `MOVE_THRESHOLD` (relative, 0.1 = 10%): POST `/api/n8n/callback` (re-plans roadmaps) and post a Discord summary.\n\nFirst production run only stores a baseline. Static data is NOT saved on manual editor runs.",
        "height": 300,
        "width": 520
      },
      "id": "3f1b7a52-8c3e-4f0e-9d61-2b4f5a6c7d81",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -260,
        -400
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 22 * * 0"
            }
          ]
        }
      },
      "id": "0095d2bd-469e-4d44-af5e-fb14374e72a4",
      "name": "Every Sunday 22:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        -100
      ]
    },
    {
      "parameters": {},
      "id": "0c8e4eff-a05a-445c-a0b1-f0b6c87c03e9",
      "name": "Run now (test)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        100
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "f3c0c42c-0000",
              "name": "APP_URL",
              "value": "https://YOUR-APP-URL",
              "type": "string"
            },
            {
              "id": "f3c0c42c-0001",
              "name": "DISCORD_WEBHOOK_URL",
              "value": "https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN",
              "type": "string"
            },
            {
              "id": "f3c0c42c-0002",
              "name": "ROLES",
              "value": "ml-engineer,software-engineer,data-analyst",
              "type": "string"
            },
            {
              "id": "f3c0c42c-0003",
              "name": "MOVE_THRESHOLD",
              "value": 0.1,
              "type": "number"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "f3c0c42c-0676-4263-bc22-bfcf0cef3b0d",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "notes": "Edit me: app URL + Discord webhook",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// One item per role id from Config.ROLES (comma separated).\nconst roles = String($('Config').first().json.ROLES || '')\n  .split(',')\n  .map((r) => r.trim())\n  .filter(Boolean);\nreturn roles.map((roleId) => ({ json: { roleId } }));\n"
      },
      "id": "99e966a2-9b9f-43cc-9012-63ea6c1286d4",
      "name": "Roles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.APP_URL.replace(/\\/+$/, '') }}/api/market/{{ $json.roleId }}?refresh=1",
        "options": {
          "timeout": 120000
        }
      },
      "id": "d00b6436-2919-4b7a-a6d8-124fc4813f40",
      "name": "Fetch market demand",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Compare each role's skill shares with the previous run (workflow static data).\n// NOTE: static data is only persisted for production (scheduled/active) runs,\n// not for manual \"Execute workflow\" runs in the editor.\nconst cfg = $('Config').first().json;\nconst threshold = Number(cfg.MOVE_THRESHOLD ?? 0.1); // 0.1 = relative change of more than 10%\nconst store = $getWorkflowStaticData('global');\nconst prev = store.shares || {};\nconst next = { ...prev };\nconst details = [];\nconst fetched = [];\nconst failed = [];\n\nconst roleItems = $('Roles').all();\n$input.all().forEach((item, i) => {\n  const res = item.json || {};\n  const roleIdHint = roleItems[i] ? roleItems[i].json.roleId : undefined;\n  if (res.ok !== true || !res.data || !Array.isArray(res.data.skills)) {\n    failed.push(roleIdHint || `item-${i}`);\n    return;\n  }\n  const d = res.data;\n  const roleId = d.roleId || roleIdHint;\n  fetched.push(roleId);\n  const before = prev[roleId] || {};\n  const now = {};\n  for (const s of d.skills) {\n    if (!s || typeof s.share !== 'number') continue;\n    now[s.skillId] = s.share;\n    const old = before[s.skillId];\n    if (typeof old === 'number' && old > 0) {\n      const change = (s.share - old) / old;\n      if (Math.abs(change) > threshold) {\n        details.push({\n          roleId,\n          skillId: s.skillId,\n          from: old,\n          to: s.share,\n          changePct: Math.round(change * 1000) / 10,\n        });\n      }\n    }\n  }\n  next[roleId] = now;\n});\n\nstore.shares = next;\nstore.lastRunAt = new Date().toISOString();\n\nconst moved = [...new Set(details.map((m) => m.skillId))];\nconst lines = details\n  .slice(0, 15)\n  .map((m) => `• **${m.skillId}** (${m.roleId}): ${(m.from * 100).toFixed(0)}% → ${(m.to * 100).toFixed(0)}% (${m.changePct > 0 ? '+' : ''}${m.changePct}%)`);\nreturn [{ json: {\n  movedCount: moved.length,\n  moved,\n  details,\n  fetched,\n  failed,\n  discordText: ['📈 **Keystone market refresh:** skill demand moved this week', ...lines].join('\\n').slice(0, 1800),\n} }];\n"
      },
      "id": "db1fc664-f738-4aa7-9785-da0a8aa2abe4",
      "name": "Compare with last run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "925a2ee7-cond",
              "leftValue": "={{ $json.movedCount }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "925a2ee7-19eb-4c3a-8991-700514b9d8ce",
      "name": "Any skill moved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.APP_URL.replace(/\\/+$/, '') }}/api/n8n/callback",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: 'market-refresh', result: { moved: $json.moved, details: $json.details } }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "62663771-ce93-4722-9999-ee6bf54b1c8f",
      "name": "Notify Keystone callback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        -100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ksSharedSecret01",
          "name": "Keystone shared secret"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const cmp = $('Compare with last run').first().json;\nconst cb = $input.first().json || {};\nconst n = cb && cb.ok && cb.data && typeof cb.data.replanned === 'number' ? cb.data.replanned : null;\nconst tail = n === null ? '' : `\\n🔁 Re-planned ${n} roadmap${n === 1 ? '' : 's'}.`;\nreturn [{ json: { discordBody: { content: (cmp.discordText + tail).slice(0, 1990) } } }];\n"
      },
      "id": "19fedd78-1b27-4fcb-b57d-d75a71b6281f",
      "name": "Build Discord summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        -100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ (() => { const u = $('Config').first().json.DISCORD_WEBHOOK_URL; return u + (u.includes('?') ? '&' : '?') + 'wait=true'; })() }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.discordBody) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "4759bc7f-b4d5-4d76-896c-335bebd8fe84",
      "name": "Post to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        -100
      ]
    }
